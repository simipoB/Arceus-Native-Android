# dm/host unit tests in one command: make -C dm/host/tests GAME=<base game title ID> run (takes seconds; build output goes to build/ and is not committed)
B = build
# game profile header (dm.h needs game_profile.h, generated by the host Makefile into ../gen/<profile>/)
# tests that use the game profile need GAME=<base game title ID> (there is no default game); GINC only expands when used, so tests without the profile build as before
GINC = $(if $(strip $(GAME)),-I../gen/$(GAME) -I../../games/$(GAME),$(error GAME is not set: make GAME=<base game title ID>: $(shell python3 ../../games/game.py list | awk -F'\t' '{printf "%s (%s)  ", $$1, $$3}')))
GAME_H = ../gen/$(GAME)/game_profile.h
run: $(B)/t_touch $(B)/t_oe $(B)/t_fs $(B)/t_thread_leak $(B)/t_fs_case $(B)/t_audio $(B)/t_audio_spsc $(B)/t_swkbd $(B)/t_altstack $(B)/t_condvar $(B)/t_condvar_old $(B)/t_resscale
	$(B)/t_touch
	$(B)/t_oe 2>/dev/null
	$(B)/t_fs 2>/dev/null
	$(B)/t_thread_leak
	TMPDIR="$(abspath $(B))" $(B)/t_fs_case 2>/dev/null
	$(B)/t_audio
	$(B)/t_audio_spsc
	$(B)/t_swkbd
	$(B)/t_altstack
	$(B)/t_condvar
	$(B)/t_condvar_old
	$(B)/t_resscale 2>/dev/null
$(GAME_H):
	$(MAKE) -C .. game_profile GAME=$(GAME)
$(B)/t_touch: t_touch.c ../hle_touch.c ../front.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_touch.c ../hle_touch.c
$(B)/t_thread_leak: t_thread_leak.c ../thread.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_thread_leak.c
$(B)/t_fs: t_fs.c t_fs_stub.c ../hle_fs.c ../hle_bigstack.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_fs.c t_fs_stub.c ../hle_bigstack.c
$(B)/t_fs_case: t_fs_case.c ../hle_fs.c ../hle_bigstack.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_fs_case.c ../hle_bigstack.c
$(B)/t_audio: t_audio.c ../hle_audio.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_audio.c -framework AudioToolbox
$(B)/t_audio_spsc: t_audio_spsc.c ../hle_audio.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_audio_spsc.c -framework AudioToolbox
$(B)/t_audio_spsc_tsan: t_audio_spsc.c ../hle_audio.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -g -O1 -fsanitize=thread -Wno-unused-function -I.. $(GINC) -o $@ t_audio_spsc.c -framework AudioToolbox
$(B)/t_swkbd: t_swkbd.c ../hle_swkbd.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_swkbd.c ../hle_swkbd.c
$(B)/t_altstack: t_altstack.c t_altstack_stub.c ../crash.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_altstack.c t_altstack_stub.c ../crash.c
$(B)/t_oe: t_oe.c ../hle_oe.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_oe.c
$(B)/t_condvar: t_condvar.c t_condvar_stub.c ../hle_thread.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -DDM_TEST_HOOKS -I.. $(GINC) -o $@ t_condvar.c t_condvar_stub.c ../hle_thread.c
$(B)/t_condvar_old: t_condvar.c t_condvar_stub.c ../hle_thread.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -DDM_TEST_HOOKS -DDM_TEST_CV_OLD_ORDER -I.. $(GINC) -o $@ t_condvar.c t_condvar_stub.c ../hle_thread.c
$(B)/t_resscale: t_resscale.c ../hle_resscale.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_resscale.c
$(B):
	mkdir -p $@
.PHONY: run tsan linux
tsan: $(B)/t_audio_spsc_tsan
	$(B)/t_audio_spsc_tsan
# Linux (WSL) / Android only: the crash record's first line names code from /proc/self/maps (make GAME=<base game title ID> linux)
$(B)/t_crash_line: t_crash_line.c ../crash_line.h ../dm.h $(GAME_H) | $(B)
	cc -O1 -fPIE -pie -Wno-unused-function -I../../android/compat -I.. $(GINC) -o $@ t_crash_line.c -ldl
linux: $(B)/t_crash_line
	$(B)/t_crash_line
# PC Linux (WSL, glibc, any CPU): host files built with cc against dm/android/compat, t_linux_prelude.h in place of the Android one (make GAME=<base game title ID> linux-step / linux-thread)
LGEN = $(B)/linux-gen/$(if $(strip $(GAME)),$(GAME),$(error GAME is not set: make GAME=<base game title ID>))
LCC = cc -O1 -g -pthread -Wall -Wno-unused-function -Wno-unused-variable -Wno-format -include t_linux_prelude.h -I../../android/compat -I.. -I$(LGEN) -DDM_TEST_HOOKS
$(LGEN)/game_profile.h: | $(B)
	mkdir -p $(dir $@); python3 ../../games/game.py header $(GAME) $@
# the step trace's reads (hle_steptrace.c) on a fake main image
$(B)/t_steptrace_linux: t_steptrace.c ../hle_steptrace.c ../hle.h ../dm.h t_linux_prelude.h $(LGEN)/game_profile.h
	$(LCC) -o $@ t_steptrace.c
linux-step: $(B)/t_steptrace_linux
	$(B)/t_steptrace_linux
.PHONY: linux-step
# the lock and wait SVCs of hle_thread.c: t_condvar, its negative control, and t_svc_wake once per wake path (DM_SVC_WAKE=locked / after, T_SECS of stress
#   each, default 10), whose "=" lines must agree
T_SECS ?= 10
LTHR = ../hle_thread.c t_condvar_stub.c t_linux_stub.c
LDEP = $(LTHR) ../dm.h t_linux_prelude.h $(LGEN)/game_profile.h
$(B)/t_condvar_linux: t_condvar.c $(LDEP)
	$(LCC) -o $@ t_condvar.c $(LTHR) -ldl
$(B)/t_condvar_old_linux: t_condvar.c $(LDEP)
	$(LCC) -DDM_TEST_CV_OLD_ORDER -o $@ t_condvar.c $(LTHR) -ldl
$(B)/t_svc_wake_linux: t_svc_wake.c $(LDEP)
	$(LCC) -o $@ t_svc_wake.c $(LTHR) -ldl
linux-thread: $(B)/t_condvar_linux $(B)/t_condvar_old_linux $(B)/t_svc_wake_linux
	$(B)/t_condvar_linux
	$(B)/t_condvar_old_linux
	DM_SVC_WAKE=locked T_SECS=$(T_SECS) $(B)/t_svc_wake_linux | tee $(B)/svc_wake_locked.txt
	DM_SVC_WAKE=after T_SECS=$(T_SECS) $(B)/t_svc_wake_linux | tee $(B)/svc_wake_after.txt
	grep -q '^all passed' $(B)/svc_wake_locked.txt && grep -q '^all passed' $(B)/svc_wake_after.txt
	grep '^=' $(B)/svc_wake_locked.txt > $(B)/svc_wake_locked.eq; grep '^=' $(B)/svc_wake_after.txt > $(B)/svc_wake_after.eq
	diff $(B)/svc_wake_locked.eq $(B)/svc_wake_after.eq && echo "t_svc_wake: both wake paths give the same results"
.PHONY: linux-thread
